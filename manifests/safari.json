{
  "manifest_version": 3,
  "name": "BetterKnightsUI - New Look for myUCF",
  "version": "2.0",
  "description": "Makes myUCF cleaner and easier to navigate for a better course browsing experience!",
  "permissions": ["storage", "nativeMessaging"],
  "host_permissions": ["*://www.ratemyprofessors.com/*", "*://ratemyprofessors.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "images/popup_icon.png"
  },
  "icons": {
    "128": "images/popup_icon_128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "images/popup_icon_128.png",
        "css/vendor/*",
        "css/webfonts/*",
        "css/fonts/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "js": [
        "scripts/browser-polyfill.min.js",
        "scripts/jquery.min.js",
        "scripts/main_script.js",
        "scripts/table_generator.js",
        "scripts/copy_for_llm.js",
        "scripts/calendar_export.js",
        "scripts/schedule_extract.js",
        "scripts/calendar_export_page.js",
        "scripts/datatables.min.js",
        "scripts/rateMyProfessorAPI.js",
        "scripts/professorNameMatching.js",
        "scripts/bootstrap.min.js"
      ],
      "css": ["css/style.css", "css/datatables.min.css"],
      "matches": [
        "https://csprod-ss.net.ucf.edu/*/CSPROD/STUDENT/*",
        "https://csprod-ss.net.ucf.edu/psc/CSPROD/*",
        "https://csprod-ss.net.ucf.edu/psp/CSPROD/*",
        "https://my.ucf.edu/psp/IHPROD/EMPLOYEE/CSPROD/*"
      ],
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "scripts/background.js"
  }
}
